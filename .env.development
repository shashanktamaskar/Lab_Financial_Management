# Development Environment Variables
NODE_ENV=development
PORT=3000

# For demo mode (GitHub Pages)
VITE_DEMO_MODE=false
VITE_API_URL=http://localhost:3000/api/trpc

# Database (use local MySQL or Docker)
DATABASE_URL=mysql://root:password@localhost:3306/lab_finance

# Mock credentials for development
AWS_ACCESS_KEY_ID=mock_key
AWS_SECRET_ACCESS_KEY=mock_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=lab-finance-dev

SESSION_SECRET=dev_secret_change_in_production
